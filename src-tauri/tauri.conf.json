{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "agentwatch",
  "version": "0.1.0",
  "identifier": "dev.agentwatch.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "agentwatch",
        "width": 320,
        "height": 520,
        "minWidth": 240,
        "minHeight": 120,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Oscar Freeman",
    "shortDescription": "Floating widget showing live Claude Code sessions",
    "longDescription": "agentwatch is a small always-on-top widget that shows the state of your Claude Code sessions (working, needs you, done) using Claude Code hooks.",
    "homepage": "https://github.com/Racso1230/agentwatch",
    "category": "DeveloperTool",
    "copyright": "Copyright (c) 2026 Oscar Freeman",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
